<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Vision Cane AI</string>
    <key>CFBundleName</key>
    <string>VisionCaneAI</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>18.0</string>

    <!-- ===== Permissions ===== -->
    <key>NSCameraUsageDescription</key>
    <string>前方の点字ブロックや障害物をカメラ映像から認識するために使用します。映像は端末内のみで処理され、外部へ送信されません。</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>「前方は？」などの音声コマンドを受け付けるためにマイクを使用します。音声は端末内のみで処理されます。</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>音声コマンドを理解するためにオンデバイス音声認識を使用します。データは端末外に送信されません。</string>
    <key>NSMotionUsageDescription</key>
    <string>白杖の向きと歩行状態を把握するためにモーションセンサを使用します。</string>

    <!-- ===== ARKit ===== -->
    <key>NSRequiresARKit</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>arkit</string>
    </array>

    <!-- ===== Background ===== -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- ===== Cloud を完全ブロック ===== -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- ===== UI ===== -->
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
